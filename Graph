        if (!hayGrafo()) {
            return;
        }
        int n = grafo.getCantidadVertices();
        if (grafo.getCantidadAristas() == n * (n - 1) / 2) {
            System.out.println("El grafo ya tiene todas las aristas posibles.");
            return;
