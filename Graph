    }

    @Override
    public String toString() {
        return origen + " -- " + destino + " (peso: " + peso + ")";
    }
}

public class ConjuntosDisjuntos {
    private final int[] padre;
    private final int[] rango;

    public ConjuntosDisjuntos(int cantidadVertices) {
        padre = new int[cantidadVertices + 1];
        rango = new int[cantidadVertices + 1];
        for (int i = 1; i <= cantidadVertices; i++) {
            padre[i] = i;
        }
    }

    public int encontrar(int vertice) {
        if (padre[vertice] != vertice) {
            padre[vertice] = encontrar(padre[vertice]);
        }
        return padre[vertice];
    }

    public boolean unir(int a, int b) {
        int raizA = encontrar(a);
        int raizB = encontrar(b);
        if (raizA == raizB) {
            return false;
        }
        if (rango[raizA] < rango[raizB]) {
            padre[raizA] = raizB;
        } else if (rango[raizA] > rango[raizB]) {
            padre[raizB] = raizA;
        } else {
            padre[raizB] = raizA;
            rango[raizA]++;
        }
        return true;
    }
}

import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.PriorityQueue;

public class Dijkstra {
    private static class Estado {
        int vertice;
        long distancia;

        Estado(int vertice, long distancia) {
            this.vertice = vertice;
            this.distancia = distancia;
        }
    }

    private Dijkstra() {
    }

    public static void ejecutar(Grafo grafo, int origen) {
        if (!grafo.existeVertice(origen)) {
            throw new IllegalArgumentException("El vertice de origen no existe.");
        }

        int n = grafo.getCantidadVertices();
        long[] distancias = new long[n + 1];
        int[] anterior = new int[n + 1];
        Arrays.fill(distancias, Grafo.INFINITO);
        Arrays.fill(anterior, -1);
        distancias[origen] = 0;

        PriorityQueue<Estado> cola = new PriorityQueue<>(Comparator.comparingLong(e -> e.distancia));
        cola.add(new Estado(origen, 0));

        while (!cola.isEmpty()) {
            Estado actual = cola.poll();
            int u = actual.vertice;
            if (actual.distancia != distancias[u]) {
                continue;
            }

            for (int v = 1; v <= n; v++) {
                if (!grafo.existeArista(u, v)) {
                    continue;
                }
                long peso = grafo.getPeso(u, v);
                long nuevaDistancia = distancias[u] + peso;
                if (nuevaDistancia < distancias[v]) {
                    distancias[v] = nuevaDistancia;
                    anterior[v] = u;
                    cola.add(new Estado(v, nuevaDistancia));
                }
            }
        }

        System.out.println("\n--- DIJKSTRA ---");
        System.out.println("Vertice de origen: " + origen);
        for (int destino = 1; destino <= n; destino++) {
            if (distancias[destino] == Grafo.INFINITO) {
                System.out.println("Hacia " + destino + ": no existe ruta.");
            } else {
                System.out.println("Hacia " + destino + " | Distancia: " + distancias[destino]
                        + " | Ruta: " + construirRuta(anterior, destino));
            }
        }
    }

    private static String construirRuta(int[] anterior, int destino) {
        List<Integer> ruta = new ArrayList<>();
        for (int v = destino; v != -1; v = anterior[v]) {
            ruta.add(v);
        }
        Collections.reverse(ruta);
        StringBuilder texto = new StringBuilder();
        for (int i = 0; i < ruta.size(); i++) {
            if (i > 0) {
                texto.append(" -> ");
            }
            texto.append(ruta.get(i));
        }
        return texto.toString();
    }
}

import java.util.Scanner;

public class Entrada {
    private Entrada() {
    }

    public static int leerEntero(Scanner scanner, String mensaje, int minimo, int maximo) {
        while (true) {
            System.out.print(mensaje);
            String linea = scanner.nextLine().trim();
            try {
                int numero = Integer.parseInt(linea);
                if (numero >= minimo && numero <= maximo) {
                    return numero;
                }
            } catch (NumberFormatException e) {
                // Se vuelve a solicitar la entrada.
            }
            System.out.println("Entrada invalida. Ingresa un entero entre " + minimo + " y " + maximo + ".");
        }
    }

    public static long leerPeso(Scanner scanner, String mensaje) {
        while (true) {
            System.out.print(mensaje);
            String linea = scanner.nextLine().trim();
            try {
                long numero = Long.parseLong(linea);
                if (numero >= 0 && numero <= Grafo.MAX_PESO) {
                    return numero;
                }
            } catch (NumberFormatException e) {
                // Se vuelve a solicitar la entrada.
            }
            System.out.println("Peso invalido. Ingresa un entero entre 0 y " + Grafo.MAX_PESO + ".");
        }
    }
}

public class FloydWarshall {
    private FloydWarshall() {
    }

    public static void ejecutar(Grafo grafo) {
        int n = grafo.getCantidadVertices();
        long[][] distancias = new long[n][n];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                distancias[i][j] = grafo.getPeso(i + 1, j + 1);
            }
        }

        for (int k = 0; k < n; k++) {
            for (int i = 0; i < n; i++) {
                if (distancias[i][k] == Grafo.INFINITO) {
                    continue;
                }
                for (int j = 0; j < n; j++) {
                    if (distancias[k][j] == Grafo.INFINITO) {
                        continue;
                    }
                    long pasandoPorK = distancias[i][k] + distancias[k][j];
                    if (pasandoPorK < distancias[i][j]) {
                        distancias[i][j] = pasandoPorK;
                    }
                }
            }
        }

        System.out.println("\n--- FLOYD-WARSHALL ---");
        System.out.println("Matriz final de distancias minimas (INF = inalcanzable):");
        System.out.printf("%12s", "");
        for (int j = 1; j <= n; j++) {
            System.out.printf("%12d", j);
        }
        System.out.println();
        for (int i = 0; i < n; i++) {
            System.out.printf("%12d", i + 1);
            for (int j = 0; j < n; j++) {
                long distancia = distancias[i][j];
                System.out.printf("%12s", distancia == Grafo.INFINITO ? "INF" : Long.toString(distancia));
            }
            System.out.println();
        }
    }
}

import java.util.ArrayList;
import java.util.List;

public class Grafo {
    public static final int MAX_VERTICES = 100;
    public static final long MAX_PESO = 1_000_000_000_000L;
    public static final long INFINITO = Long.MAX_VALUE / 4;

    private long[][] matriz;
    private int cantidadVertices;
    private int cantidadAristas;

    public Grafo(int numeroVertices) {
        if (numeroVertices < 1 || numeroVertices > MAX_VERTICES) {
            throw new IllegalArgumentException("La cantidad de vertices debe estar entre 1 y " + MAX_VERTICES);
        }
        cantidadVertices = numeroVertices;
        cantidadAristas = 0;
        matriz = crearMatriz(numeroVertices);
    }

    private static long[][] crearMatriz(int n) {
        long[][] nueva = new long[n][n];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                nueva[i][j] = (i == j) ? 0 : INFINITO;
            }
        }
        return nueva;
    }

    public int agregarVertice() {
        if (cantidadVertices == MAX_VERTICES) {
            throw new IllegalStateException("Se alcanzo el limite de vertices.");
        }
        int nuevoTamano = cantidadVertices + 1;
        long[][] nueva = crearMatriz(nuevoTamano);
        for (int i = 0; i < cantidadVertices; i++) {
            System.arraycopy(matriz[i], 0, nueva[i], 0, cantidadVertices);
        }
        matriz = nueva;
        cantidadVertices = nuevoTamano;
        return cantidadVertices;
    }

    public void agregarArista(int origen, int destino, long peso) {
        if (!existeVertice(origen) || !existeVertice(destino)) {
            throw new IllegalArgumentException("Uno o ambos vertices no existen.");
        }
        if (origen == destino) {
            throw new IllegalArgumentException("No se permiten aristas de un vertice a si mismo.");
        }
        if (peso < 0 || peso > MAX_PESO) {
            throw new IllegalArgumentException("El peso debe estar entre 0 y " + MAX_PESO + ".");
        }
        if (existeArista(origen, destino)) {
            throw new IllegalArgumentException("La arista ya existe. No se permiten duplicados.");
        }
        matriz[origen - 1][destino - 1] = peso;
        matriz[destino - 1][origen - 1] = peso;
        cantidadAristas++;
    }

    public boolean existeVertice(int vertice) {
        return vertice >= 1 && vertice <= cantidadVertices;
    }

    public boolean existeArista(int origen, int destino) {
        return existeVertice(origen) && existeVertice(destino)
                && origen != destino && matriz[origen - 1][destino - 1] != INFINITO;
    }

    public long getPeso(int origen, int destino) {
        if (!existeVertice(origen) || !existeVertice(destino)) {
            throw new IllegalArgumentException("Vertice inexistente.");
        }
        return matriz[origen - 1][destino - 1];
    }

    public int getCantidadVertices() {
        return cantidadVertices;
    }

    public int getCantidadAristas() {
        return cantidadAristas;
    }

    public List<Arista> getAristas() {
        List<Arista> aristas = new ArrayList<>();
        for (int i = 1; i <= cantidadVertices; i++) {
            for (int j = i + 1; j <= cantidadVertices; j++) {
                if (existeArista(i, j)) {
                    aristas.add(new Arista(i, j, getPeso(i, j)));
                }
            }
        }
        return aristas;
    }

    public void mostrar() {
        System.out.println("\nGRAFO NO DIRIGIDO Y PONDERADO");
        System.out.println("Vertices: " + cantidadVertices + " | Aristas: " + cantidadAristas);
        System.out.println("Matriz de adyacencia (INF = sin arista):");
        System.out.printf("%12s", "");
        for (int j = 1; j <= cantidadVertices; j++) {
            System.out.printf("%12d", j);
        }
        System.out.println();
        for (int i = 1; i <= cantidadVertices; i++) {
            System.out.printf("%12d", i);
            for (int j = 1; j <= cantidadVertices; j++) {
                long peso = getPeso(i, j);
                System.out.printf("%12s", peso == INFINITO ? "INF" : Long.toString(peso));
            }
            System.out.println();
        }
        System.out.println("Aristas:");
        List<Arista> aristas = getAristas();
        if (aristas.isEmpty()) {
            System.out.println("(Ninguna)");
        } else {
            for (Arista arista : aristas) {
                System.out.println("  " + arista);
            }
        }
    }
}

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;

public class Kruskal {
    private Kruskal() {
    }

    public static void ejecutar(Grafo grafo) {
        List<Arista> aristasOrdenadas = grafo.getAristas();
        aristasOrdenadas.sort(Comparator.comparingLong(Arista::getPeso));

        ConjuntosDisjuntos conjuntos = new ConjuntosDisjuntos(grafo.getCantidadVertices());
        List<Arista> seleccionadas = new ArrayList<>();
        long costoTotal = 0;

        for (Arista arista : aristasOrdenadas) {
            if (conjuntos.unir(arista.getOrigen(), arista.getDestino())) {
                seleccionadas.add(arista);
                costoTotal += arista.getPeso();
                if (seleccionadas.size() == grafo.getCantidadVertices() - 1) {
                    break;
                }
            }
        }

        System.out.println("\n--- KRUSKAL ---");
        System.out.println("Aristas seleccionadas (en orden de peso, sin ciclos):");
        for (Arista arista : seleccionadas) {
            System.out.println("  " + arista);
        }
        if (seleccionadas.isEmpty()) {
            System.out.println("  No fue necesario seleccionar aristas.");
        }
        if (seleccionadas.size() == grafo.getCantidadVertices() - 1) {
            System.out.println("Peso total del arbol de expansion minima: " + costoTotal);
        } else {
            System.out.println("El grafo no es conexo: no existe un arbol de expansion minima global.");
            System.out.println("Se obtuvo un bosque de expansion minima.");
            System.out.println("Peso total del bosque: " + costoTotal);
        }
    }
}

